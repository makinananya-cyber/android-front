<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; every screen is drawn by Compose (HisaabWiseTheme). -->
    <style name="Theme.HisaabWise" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/hw_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- System splash (Android 12+ and the compat library below it): cream ground + mark. -->
    <style name="Theme.HisaabWise.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hw_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/hw_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.HisaabWise</item>
    </style>
</resources>
