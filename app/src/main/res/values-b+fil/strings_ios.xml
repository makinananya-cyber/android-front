    <string name="walkthrough_a11y_label">Gabay na tour</string>
    <string name="walkthrough_acCurrency_body">Baguhin ang pera kung saan ipinapakita ang salapi mo. Pumili ng bago at **ang bawat halaga sa app ay agad na nako-convert** dito.</string>
    <string name="walkthrough_acCurrency_title">Piliin ang pera mo</string>
    <string name="walkthrough_acLanguage_body">Piliin ang wikang gusto mong gamitin sa app. Maghanap sa listahan para mabilis mahanap ang iyo.</string>
    <string name="walkthrough_acLanguage_title">Piliin ang wika mo</string>
    <string name="walkthrough_acPassword_body">Baguhin ang password mo rito. Itatanong muna namin ang dalawang security question mo, para ikaw lang ang makakagawa nito.</string>
    <string name="walkthrough_acPassword_title">Pananatilihing ligtas ang account mo</string>
    <string name="walkthrough_acPersonal_body">I-tap ito para makita o baguhin ang pangalan, numero ng telepono at buwanang sahod mo. Ang sahod mo ang ginagamit ng app para tuusin ang badyet mo, kaya panatilihin itong napapanahon.</string>
    <string name="walkthrough_acPersonal_title">Ang mga personal na detalye mo</string>
    <string name="walkthrough_add_body">I-tap ito tuwing may ginagastos ka. Habang mas marami kang idinadagdag, mas nagiging kapaki-pakinabang ang lahat.</string>
    <string name="walkthrough_add_firstrun_body">I-tap ito para itala ang una mo. Bubuhay ang lahat sa screen na ito kapag ginawa mo iyon.</string>
    <string name="walkthrough_add_firstrun_title">Magsimula sa pagdagdag ng gastos</string>
    <string name="walkthrough_add_title">Idagdag ang ginagastos mo</string>
    <string name="walkthrough_back">Bumalik</string>
    <string name="walkthrough_count">Hakbang %1$s ng %2$s</string>
    <string name="walkthrough_duo_body">Sa kaliwa, ang lesson streak mo — i-tap ito para ipagpatuloy kung saan ka tumigil. Sa kanan, mga gabay sa **pagtukoy ng scam**, **pagpapadala ng pera sa pamilya**, at **pagharap sa utang**. I-tap ang alinman para basahin.</string>
    <string name="walkthrough_duo_title">Patuloy na matuto, at magbasa</string>
    <string name="walkthrough_exBudget_body">Ang transportasyon, libangan at iba pang gastos ay galing sa allowance na batay sa sahod mo. Pupula ang bar na ito kung lumagpas ka.</string>
    <string name="walkthrough_exBudget_title">Magkano ang natitira para sa gusto</string>
    <string name="walkthrough_exCats_body">I-tap ang isang kategorya para makita ang lahat ng itinala mo rito, magdagdag ng bagong entry, o ayusin ang mali.</string>
    <string name="walkthrough_exCats_title">Bawat kategorya, isang tap lang</string>
    <string name="walkthrough_exSummary_body">Lahat ng ginastos mo, hinati sa **fixed** na mga bill na paulit-ulit, **variable** na pang-araw-araw na gastos, at anumang **dagdag** na perang pumasok.</string>
    <string name="walkthrough_exSummary_title">Ang buwan mo sa isang sulyap</string>
    <string name="walkthrough_finish">Tapos</string>
    <string name="walkthrough_finish_body">Handa ka na. Gusto mo itong makita ulit? Ito ang row na **Gawin ang tour** sa screen na ito.</string>
    <string name="walkthrough_finish_title">Iyon na ang lahat</string>
    <string name="walkthrough_learn_body">Maiikling aralin tungkol sa pera, sa simpleng salita. Tapusin ang isa para ma-unlock ang susunod, at panatilihin ang streak mo araw-araw.</string>
    <string name="walkthrough_learn_title">Matuto habang nagpapatuloy</string>
    <string name="walkthrough_next">Susunod</string>
    <string name="walkthrough_repHero_body">Isang bar para sa bawat buwan na sinubaybayan mo. Berde ang ibig sabihin naabot mo ang layunin sa ipon, pula ang ibig sabihin kulang ka.</string>
    <string name="walkthrough_repHero_title">Kumusta ang mga nakaraang buwan</string>
    <string name="walkthrough_repMonth_body">I-tap ang isang buwan para makita ang buong ulat nito — ang parehong mga chart sa home screen mo, kasama ang bawat bagay na itinala mo noong buwang iyon.</string>
    <string name="walkthrough_repMonth_title">Buksan ang alinmang buwan</string>
    <string name="walkthrough_replay">Gawin ang tour</string>
    <string name="walkthrough_replay_subtitle">Tingnan kung paano gumagana ang app</string>
    <string name="walkthrough_savings_body">Ang bar ay mula sa walang naipon sa kaliwa hanggang sa layunin mo sa kanan. Ipinapakita ng marka kung nasaan ka — layunin mong ilapit ito sa berde.</string>
    <string name="walkthrough_savings_title">Subaybayan ang layunin mo sa ipon</string>
    <string name="walkthrough_skip">Laktawan ang tour</string>
    <string name="walkthrough_spend_body">Hinahati ng bilog na ito ang paggastos mo ayon sa kategorya. I-tap ang alinmang kulay, o alinmang pangalan sa listahan, para makita lang iyon.</string>
    <string name="walkthrough_spend_firstrun_body">Wala pa ito ngayon. Magdagdag ng ilang gastos at mapupuno ang bilog na ito ng kulay para sa bawat kategorya.</string>
    <string name="walkthrough_spend_firstrun_title">Dito lalabas ang paggastos mo</string>
    <string name="walkthrough_spend_title">Tingnan kung saan napupunta ang pera mo</string>
    <string name="walkthrough_start">Ipakita sa akin</string>
    <string name="walkthrough_tip_body">Isang maikling payo sa pera, sa simpleng salita. I-tap ang **Magpakita ng iba** kung gusto mo ng ibang isa.</string>
    <string name="walkthrough_tip_title">Isang tip bawat araw</string>
    <string name="walkthrough_welcome_body">Ipapakita namin sa iyo ang paligid. Aabutin ito ng mga isang minuto, at maaari kang huminto anumang oras.</string>
    <string name="walkthrough_welcome_title">Maligayang pagdating sa HisaabWise</string>
